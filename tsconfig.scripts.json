{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "@cloudflare/workers-types"],
    "tsBuildInfoFile": "./node_modules/.tmp/scripts.tsbuildinfo"
  },
  "include": ["scripts"]
}
