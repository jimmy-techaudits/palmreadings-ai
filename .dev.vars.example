# Copy to .dev.vars for local development. Never commit .dev.vars.

# Which model provider to use: mock | anthropic | openai | gemini
AI_PROVIDER=mock

# Models. OBSERVE_MODEL reads the photos; INTERPRET_MODEL writes the reading. wrangler.jsonc sets both to
# OpenAI's gpt-5.6-sol for production, and those apply here too unless you set them: when you use
# anthropic or gemini locally, set both to a model of that provider.
# OBSERVE_MODEL=
# INTERPRET_MODEL=

# Models for `npm run compare` (defaults shown):
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5.6-sol

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Google Workspace (contact form email + feedback/usage log). See "Contact form and Google Workspace"
# in the README. Leave unset locally to just print contact messages in the terminal.
# GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/.../exec
# GOOGLE_SCRIPT_SECRET=the same long random string as the script's SECRET property

# Bot protection (Cloudflare Turnstile). Leave unset to skip the check locally.
# Cloudflare's always-pass test secret, to try the full flow:
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# The matching public site key goes in .env (read at build time):
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Rate limits (defaults shown). Skipped on localhost unless ENFORCE_LIMITS_LOCALLY=true.
# READINGS_PER_HOUR_PER_IP=5
# READINGS_PER_DAY_PER_IP=15
# READINGS_PER_DAY_TOTAL=500
# RATE_LIMIT_SALT=any-long-random-string
