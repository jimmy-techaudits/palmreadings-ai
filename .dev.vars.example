# Copy to .dev.vars for local development. Never commit .dev.vars.

# Which model provider to use: mock | anthropic | openai | gemini
AI_PROVIDER=mock

# Model overrides (optional for anthropic; required for openai and gemini).
# OBSERVE_MODEL reads the photos; INTERPRET_MODEL writes the reading.
# OBSERVE_MODEL=
# INTERPRET_MODEL=

# Models for `npm run compare` (defaults shown):
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5.6-sol

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: server-side forwarding of feedback / anonymous usage events
# (e.g. the existing Google Apps Script web app URLs). Kept off the client.
# FEEDBACK_WEBHOOK_URL=
# USAGE_WEBHOOK_URL=

# Contact form delivery (pick one). Resend sends a real email; the webhook can be
# a Google Apps Script that emails you from Google Workspace.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=hello@palmreadings.ai
# CONTACT_FROM_EMAIL=Palm Readings AI <website@palmreadings.ai>
# CONTACT_WEBHOOK_URL=

# Bot protection (Cloudflare Turnstile). Leave unset to skip the check locally.
# Cloudflare's always-pass test secret, to try the full flow:
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# The matching public site key goes in .env (read at build time):
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Rate limits (defaults shown). Skipped on localhost unless ENFORCE_LIMITS_LOCALLY=true.
# READINGS_PER_HOUR_PER_IP=5
# READINGS_PER_DAY_PER_IP=15
# READINGS_PER_DAY_TOTAL=500
# RATE_LIMIT_SALT=any-long-random-string
