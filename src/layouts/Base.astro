---
import '../styles/global.css';
import { CONTACT_EMAIL, GA_ID, IMAGES } from '../site';
import { pageGraph, SHARE_IMAGE, SITE_NAME, type PageType } from '../seo';

interface Props {
  /** Under 60 characters, ending in "| Palm Readings AI". */
  title: string;
  /** About 140 to 160 characters. */
  description: string;
  /** Hide the "Start a Reading" button (on the reading page itself). */
  hideCta?: boolean;
  /** Keep the page out of search engines (private reading links, 404). */
  noindex?: boolean;
  /** schema.org page type for the structured data. */
  pageType?: PageType;
  /** This page's name in the breadcrumb trail (Home > name). Omit on the home page. */
  breadcrumb?: string;
  /** Extra schema.org nodes for this page, e.g. the reading service. */
  schema?: Record<string, unknown>[];
}
const { title, description, hideCta = false, noindex = false, pageType, breadcrumb, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const shareImage = new URL(SHARE_IMAGE, Astro.site).toString();
const jsonLd = noindex ? null : pageGraph({ path: Astro.url.pathname, title, description, type: pageType, breadcrumb, extra: schema });
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const current = Astro.url.pathname;
const year = new Date().getFullYear();
const sparkle = 'M11 3l1.6 5.4L18 10l-5.4 1.6L11 17l-1.6-5.4L4 10l5.4-1.6z';
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <>
          <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
          <link rel="canonical" href={canonical} />
        </>
      )
    }
    {noindex && <meta name="referrer" content="no-referrer" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Palm Readings AI: AI palm reading from photos of your hands" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="theme-color" content="#06060f" />
    <link rel="icon" type="image/png" sizes="32x32" href={IMAGES.favicon} />
    <link rel="apple-touch-icon" href={IMAGES.appleTouchIcon} />
    <link rel="manifest" href="/site.webmanifest" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="relative z-30 border-b border-white/[0.08] bg-[linear-gradient(180deg,rgba(28,14,58,0.92),rgba(10,8,24,0.88))] print:hidden">
      <div class="mx-auto flex max-w-[1200px] items-center justify-between gap-x-3 gap-y-4 px-4 py-3.5 max-[359px]:px-3 sm:gap-x-6 sm:px-8">
        <a href="/" aria-label="Palm Readings AI home" class="flex shrink-0 items-center rounded-lg">
          <img src={IMAGES.logoSmall} alt="Palm Readings AI" width="420" height="180" fetchpriority="high" class="block h-12 w-auto max-[359px]:h-10 sm:h-16" />
        </a>
        <nav class="flex items-center gap-1.5" aria-label="Main">
          {nav.map((n) => (
            <a
              href={n.href}
              aria-current={current === n.href ? 'page' : undefined}
              class:list={[
                'hidden min-h-11 items-center rounded-full px-4 py-2.5 text-base font-medium sm:inline-flex',
                current === n.href ? 'bg-gold-400/10 text-gold-300' : 'text-[#e4dcfa] hover:text-white',
              ]}
            >
              {n.label}
            </a>
          ))}
          {!hideCta && (
            <a href="/reading/?new=1" class="btn-gold ml-1 shrink-0 whitespace-nowrap px-4 py-2.5 text-base max-[359px]:px-3 max-[359px]:text-[15px] sm:ml-2.5 sm:px-[22px]">
              <svg class="max-[359px]:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={sparkle} /></svg>
              Start a Reading
            </a>
          )}
          <details class="relative sm:hidden">
            <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-full text-white [&::-webkit-details-marker]:hidden" aria-label="Menu">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </summary>
            <div class="absolute right-0 z-40 mt-2 flex w-44 flex-col rounded-[18px] border border-white/10 bg-night-900 p-2 shadow-xl">
              {nav.map((n) => (
                <a href={n.href} class:list={['flex min-h-11 items-center rounded-xl px-3', current === n.href ? 'bg-gold-400/10 text-gold-300' : 'text-ink hover:bg-white/5']}>
                  {n.label}
                </a>
              ))}
            </div>
          </details>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="relative border-t border-white/[0.09] bg-[radial-gradient(70%_120%_at_50%_0%,rgba(74,31,122,0.55),rgba(5,5,12,1)_70%)] text-base leading-relaxed print:hidden">
      <div class="mx-auto max-w-[1200px] px-4 pb-10 pt-[72px] sm:px-8">
        <div class="grid gap-10 [grid-template-columns:repeat(auto-fit,minmax(220px,1fr))]">
          <div>
            <a href="/" aria-label="Palm Readings AI home" class="inline-block rounded-lg">
              <img src={IMAGES.logoSmall} alt="Palm Readings AI" width="420" height="180" loading="lazy" class="block h-auto w-[210px]" />
            </a>
          </div>
          <div>
            <p class="mb-3.5 font-display text-base tracking-[0.1em] text-gold-400">Explore</p>
            <ul class="flex flex-col gap-2.5">
              <li><a href="/reading/?new=1" class="text-ink-soft hover:text-white">Start a reading</a></li>
              <li><a href="/about/" class="text-ink-soft hover:text-white">About us</a></li>
              <li><a href="/contact/" class="text-ink-soft hover:text-white">Contact</a></li>
            </ul>
          </div>
          <div>
            <p class="mb-3.5 font-display text-base tracking-[0.1em] text-gold-400">Legal</p>
            <ul class="flex flex-col gap-2.5">
              <li><a href="/privacy-policy/" class="text-ink-soft hover:text-white">Privacy Policy</a></li>
              <li><a href="/terms/" class="text-ink-soft hover:text-white">Terms of Use</a></li>
              <li><a href="/refund-policy/" class="text-ink-soft hover:text-white">Refund Policy</a></li>
            </ul>
          </div>
          <div>
            <p class="mb-3.5 font-display text-base tracking-[0.1em] text-gold-400">Say hello</p>
            <a href={`mailto:${CONTACT_EMAIL}`} class="text-gold-300 underline-offset-4 hover:underline">{CONTACT_EMAIL}</a>
          </div>
        </div>
        <p class="mt-14 max-w-[900px] border-t border-white/[0.08] pt-7 text-sm text-ink-subtle">
          Readings provided by PalmReadings.ai are generated using artificial intelligence and are intended for informational and
          reflective purposes only. Interpretations are not guaranteed to be accurate and should not be considered professional,
          medical, legal, or financial advice. Individual experiences may vary.
        </p>
        <p class="mt-[18px] text-sm text-ink-faint">© {year} Palm Readings AI. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
