---
import Base from '../layouts/Base.astro';

const chapters = [
  {
    numeral: 'I',
    title: 'A modern approach to an ancient practice',
    body: [
      'Palmistry has always been about observation, reflection, and interpretation. Every reading we create is grounded in traditional palmistry techniques and knowledge: hand shapes and elements, the major and minor lines, the mounts, and the smaller markings a trained palm reader looks for. We analyze the structure, lines, and features of your hands through a guided digital process and interpret them the way palmists have for generations, with a focus on consistency, clarity, and relevance.',
      'Each reading is designed to feel grounded and useful. No vague statements. No fear-based messaging. Just practical perspective you can actually sit with.',
    ],
  },
  {
    numeral: 'II',
    title: 'Your reading stays private',
    body: [
      'Readings are delivered privately, without live sessions, public profiles, or social pressure. You can explore personal insights at your own pace, on your own terms.',
      'This is a reflective tool, meant to support self-awareness, not replace personal agency or professional guidance.',
    ],
  },
  {
    numeral: 'III',
    title: 'Why PalmReadings AI exists',
    body: [
      'So many people turn to self-discovery tools when they’re at a crossroads, feeling stuck, or simply curious about themselves. We built PalmReadings AI to offer a calm, structured way to look inward.',
      'Whether you’re exploring relationships, career direction, or personal patterns, our goal is to help you walk away with language for what you’re already sensing, and a clearer understanding of how you move through the world.',
    ],
  },
];

const values = [
  {
    title: 'No fear-based messaging',
    body: 'Readings describe tendencies and possibilities, never doom or fixed outcomes.',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/>',
  },
  {
    title: 'Readings that show their work',
    body: 'Every insight points to the line or feature it was read from.',
    icon: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  },
  {
    title: 'Respect for the true art',
    body: 'AI is a fun, helpful first step. We highly recommend seeing in-person palm readers too.',
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/>',
  },
];
---

<Base
  title="About Palm Readings AI: Traditional Palmistry, Online"
  description="Palm Readings AI brings palm reading online, with readings grounded in the lines, mounts and hand shapes a palmist studies in person."
  pageType="AboutPage"
  breadcrumb="About"
>
  <div class="overflow-hidden text-[17px] leading-[1.7]">
    <!-- Hero -->
    <section class="starfield relative bg-night-950">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(55%_80%_at_50%_0%,rgba(110,52,200,0.38),transparent_70%)]" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-[960px] px-4 pb-16 pt-[72px] text-center sm:px-8 md:pb-24 md:pt-28">
        <p class="eyebrow">About us</p>
        <h1 class="mt-[18px] font-display text-[clamp(40px,5vw,68px)] font-medium leading-[1.08] text-white">
          An ancient practice, <em class="accent">reimagined</em>
        </h1>
        <p class="mx-auto mt-7 max-w-[720px] text-[19px] text-ink-soft sm:text-xl">
          PalmReadings AI brings the long tradition of palm reading to anyone, anywhere, with readings grounded in the same lines,
          mounts, and hand shapes a palmist studies in person.
        </p>
        <!-- Moon-phase divider: new, waxing, full, waning, new -->
        <div class="mx-auto mt-12 flex items-center justify-center gap-[18px] md:mt-14" aria-hidden="true">
          <span class="h-px w-[120px] min-w-0 bg-[linear-gradient(90deg,transparent,rgba(246,199,127,0.6))]"></span>
          <svg class="shrink-0" width="120" height="20" viewBox="0 0 120 20">
            <circle cx="10" cy="10" r="7" fill="none" stroke="#F6C77F" stroke-width="1.2" />
            <path d="M40 3a7 7 0 0 0 0 14 9 9 0 0 1 0-14z" fill="#F6C77F" />
            <circle cx="60" cy="10" r="8" fill="#F6C77F" />
            <path d="M80 3a7 7 0 0 1 0 14 9 9 0 0 0 0-14z" fill="#F6C77F" />
            <circle cx="110" cy="10" r="7" fill="none" stroke="#F6C77F" stroke-width="1.2" />
          </svg>
          <span class="h-px w-[120px] min-w-0 bg-[linear-gradient(90deg,rgba(246,199,127,0.6),transparent)]"></span>
        </div>
      </div>
    </section>

    <!-- Pull quote -->
    <section>
      <div class="mx-auto max-w-[1100px] px-4 pb-6 pt-10 sm:px-8 md:pt-12">
        <blockquote class="rounded-[32px] border border-gold-400/25 bg-[linear-gradient(135deg,rgba(40,22,84,0.7),rgba(14,10,34,0.7))] px-6 py-9 text-center sm:p-12">
          <p class="font-accent text-[clamp(26px,2.8vw,38px)] font-medium italic leading-[1.35] text-white">
            This is not about predicting fixed outcomes or telling you who you are supposed to be. It’s about helping you
            understand the patterns you’re already living inside of.
          </p>
        </blockquote>
      </div>
    </section>

    <!-- Chapters -->
    <section>
      <div class="mx-auto flex max-w-[1100px] flex-col gap-14 px-4 py-14 sm:px-8 md:gap-[72px] md:py-[72px]">
        {
          chapters.map((chapter, i) => (
            <>
              {i > 0 && <div class="h-px bg-[linear-gradient(90deg,transparent,rgba(201,184,240,0.25),transparent)]" aria-hidden="true" />}
              <article class="flex flex-wrap gap-x-16 gap-y-6">
                <div class="min-w-0 flex-[1_1_280px]">
                  <p class="font-display text-[56px] leading-none text-gold-400/50" aria-hidden="true">{chapter.numeral}</p>
                  <h2 class="mt-4 font-display text-[26px] font-medium leading-[1.2] text-white sm:text-[30px]">{chapter.title}</h2>
                </div>
                <div class="min-w-0 flex-[2_1_480px] text-[#c8bee8]">
                  {chapter.body.map((para, j) => <p class:list={[j > 0 && 'mt-[18px]']}>{para}</p>)}
                </div>
              </article>
            </>
          ))
        }
      </div>
    </section>

    <!-- Values -->
    <section class="border-y border-lavender-300/10 bg-night-900">
      <div class="mx-auto max-w-[1100px] px-4 py-16 sm:px-8 md:py-[88px]">
        <h2 class="text-center font-display text-[30px] font-medium leading-[1.2] text-white sm:text-[34px]">What we stand for</h2>
        <div class="mt-10 grid gap-5 [grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))] md:mt-12">
          {
            values.map((value) => (
              <div class="rounded-card border border-lavender-300/[0.14] bg-[rgba(20,16,44,0.55)] p-7 sm:p-8">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#F6C77F" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={value.icon} />
                <h3 class="mt-[18px] text-[19px] font-medium leading-snug text-white">{value.title}</h3>
                <p class="mt-2 text-base leading-relaxed text-ink-subtle">{value.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="starfield relative bg-night-950">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(45%_70%_at_50%_100%,rgba(124,58,237,0.38),transparent_70%)]" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-[800px] px-4 py-[72px] text-center sm:px-8 md:py-28">
        <h2 class="font-display text-[clamp(32px,3.6vw,48px)] font-medium leading-[1.15] text-white">
          The insight is the <em class="accent">starting point</em>
        </h2>
        <p class="mx-auto mt-[18px] max-w-[520px] text-ink-muted">What you do with it is always up to you.</p>
        <a href="/reading/?new=1" class="btn-gold mt-9 px-[34px] py-[18px] text-lg">Start your reading</a>
      </div>
    </section>
  </div>
</Base>
