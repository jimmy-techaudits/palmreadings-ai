---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Palm Readings AI" description="This page could not be found." noindex>
  <section class="starfield relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto flex max-w-xl flex-col items-center px-4 py-28 text-center">
      <p class="font-display text-7xl text-gold-400">404</p>
      <h1 class="mt-5 font-display text-4xl font-medium leading-tight text-white">This path isn’t written in the <em class="accent">stars</em></h1>
      <p class="mt-4 text-lg text-ink-muted">The page you’re looking for has moved or doesn’t exist.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-ghost px-6 py-3 text-base">Go home</a>
        <a href="/reading/?new=1" class="btn-gold px-7 py-3 text-base">Start a Reading</a>
      </div>
    </div>
  </section>
</Base>
