---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Palm Readings AI" description="This page could not be found.">
  <section class="mx-auto flex max-w-lg flex-col items-center px-4 py-24 text-center">
    <p class="font-display text-6xl text-gold-400">404</p>
    <h1 class="mt-4 font-display text-3xl text-white">This path isn’t written in the stars</h1>
    <p class="mt-3 text-violet-200/80">The page you’re looking for has moved or doesn’t exist.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-[10px] border border-white/15 px-5 py-3 font-bold text-white hover:bg-white/5">Go home</a>
      <a href="/reading/?new=1" class="rounded-[10px] bg-gold-400 px-5 py-3 font-bold text-plum-900 hover:bg-gold-500">Start a Reading</a>
    </div>
  </section>
</Base>
