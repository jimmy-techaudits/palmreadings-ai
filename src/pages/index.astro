---
import Base from '../layouts/Base.astro';
import { IMAGES } from '../site';

const steps = [
  { title: 'Choose your reading', text: 'Select the experience that matches your intention, from self-exploration to love, career, or your relationship.' },
  { title: 'Photograph your palms', text: 'Clear, well-lit photos of both hands help capture your palm lines, structure, and subtle markers.' },
  { title: 'Receive your personalized reading', text: 'Your results arrive in moments, showing exactly which features of your hands each insight comes from.' },
];

const readings = [
  { title: 'Full Life Reading', image: IMAGES.bothHands, text: 'See the full picture. Compare your inner blueprint with how you show up in the world across personality, love, career, and the turning points ahead.' },
  { title: 'Love & Relationships', image: IMAGES.loveFuture, text: 'Explore how you love, what you need, your relationship patterns, and your romantic timeline. Marriage and children insights are optional.' },
  { title: 'Career & Purpose', image: IMAGES.careerPath, text: 'Understand your natural work style, drive, strengths, and the career shifts your hands point toward.' },
  { title: 'Couples Compatibility', image: IMAGES.couples, text: 'Understand your dynamic. Read two people’s palms together to explore communication styles, emotional needs, and long-term potential.' },
];
---

<Base
  title="Palm Readings | AI-Powered Custom Palmistry Readings"
  description="Turn photos of your hands into a deeply personal palm reading about your personality, relationships, and life direction, rooted in traditional palmistry."
>
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 md:py-20">
    <div>
      <h1 class="font-display text-5xl text-white sm:text-6xl">Palm Readings</h1>
      <p class="mt-2 font-display text-xl tracking-[0.2em] text-gold-400 uppercase">Powered by AI</p>
      <p class="mt-6 text-lg leading-relaxed text-violet-100">
        Get ready for a palm reading experience that transforms photos of your hands into deeply personal insights about
        your personality, relationships, and life direction, in moments.
      </p>
      <p class="mt-4 leading-relaxed text-violet-200/80">
        Rooted in traditional palmistry and enhanced by modern AI analysis, each reading is designed to feel thoughtful,
        grounded, and surprisingly accurate, without vague fortune-telling or generic advice.
      </p>
      <a href="/reading/?new=1" class="mt-8 inline-block rounded-[10px] bg-gold-400 px-7 py-3.5 text-lg font-bold text-plum-900 shadow-lg shadow-gold-500/10 transition hover:-translate-y-0.5 hover:bg-gold-500">
        Start a Reading
      </a>
    </div>
    <div class="relative mx-auto w-full max-w-sm">
      <div class="absolute inset-8 -z-10 rounded-full bg-royal-800/50 blur-3xl"></div>
      <img src={IMAGES.icon} alt="" width="512" height="512" class="w-full" />
    </div>
  </section>

  <section class="bg-brand-band py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-center font-display text-3xl text-white sm:text-4xl">How It Works</h2>
      <ol class="mt-10 grid gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="panel p-6">
            <span class="flex size-10 items-center justify-center rounded-full bg-gold-400 font-bold text-plum-900">{i + 1}</span>
            <h3 class="mt-4 font-display text-xl text-white">{s.title}</h3>
            <p class="mt-2 leading-relaxed text-violet-200/90">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="text-center font-display text-3xl text-white sm:text-4xl">Choose Your Reading</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-violet-200/80">Every reading looks at both of your hands: the one you were born with, and the one you’ve built.</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {readings.map((r) => (
        <a href="/reading/?new=1" class="panel group flex items-center gap-5 p-6 transition hover:border-gold-400/60 hover:bg-white/[0.07]">
          <img src={r.image} alt="" class="size-24 shrink-0 object-contain" loading="lazy" />
          <span>
            <span class="block font-display text-xl text-white group-hover:text-gold-400">{r.title}</span>
            <span class="mt-2 block text-sm leading-relaxed text-violet-200/90">{r.text}</span>
          </span>
        </a>
      ))}
    </div>
    <div class="mt-12 text-center">
      <a href="/reading/?new=1" class="inline-block rounded-[10px] bg-gold-400 px-7 py-3.5 text-lg font-bold text-plum-900 transition hover:-translate-y-0.5 hover:bg-gold-500">
        Start a Reading
      </a>
    </div>
  </section>
</Base>
